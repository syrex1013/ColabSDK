{
  "name": "@syrex1013/colab-sdk",
  "version": "0.2.2",
  "description": "TypeScript SDK for Google Colab via CloakBrowser and MCP WebSocket proxy",
  "author": "syrex1013",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syrex1013/ColabSDK.git"
  },
  "bugs": {
    "url": "https://github.com/syrex1013/ColabSDK/issues"
  },
  "homepage": "https://github.com/syrex1013/ColabSDK#readme",
  "keywords": [
    "colab",
    "google-colab",
    "jupyter",
    "notebook",
    "mcp",
    "automation",
    "sdk",
    "playwright",
    "gpu"
  ],
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/API.md",
    "docs/PUBLISHING.md",
    "docs/README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "colab-dev": "bin/colab-dev.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "bun run build && bun run test:coverage",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sample": "bun run examples/03_connect_and_run.ts",
    "example:login": "bun run examples/01_login_interactive.ts",
    "example:login-creds": "bun run examples/02_login_credentials.ts",
    "example:run": "bun run examples/03_connect_and_run.ts",
    "example:cells": "bun run examples/04_manage_cells.ts",
    "example:stream": "bun run examples/05_stream_output.ts",
    "example:gpu": "bun run examples/06_select_gpu.ts",
    "example:workflow": "bun run examples/07_notebook_workflow.ts",
    "example:errors": "bun run examples/08_error_handling.ts",
    "example:workflows": "bun run examples/09_workflow_management.ts",
    "example:upload": "bun run examples/10_file_upload.ts",
    "example:t4-upload": "bun run examples/11_t4_file_upload.ts",
    "test:sdk": "bun run examples/sdk_smoke_test.ts",
    "test:full": "bun run examples/99_full_test.ts",
    "test:login": "bun run examples/test_login.ts",
    "test:auth": "bun run examples/auth_login.ts",
    "colab-dev": "bun run dist/cli/index.js"
  },
  "dependencies": {
    "cloakbrowser": "^0.3.31",
    "commander": "^13.1.0",
    "playwright-core": "1.50.1",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "@vitest/coverage-v8": "3.2.6",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
